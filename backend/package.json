{
  "name": "decarbonize-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade backend for Decarbonize carbon credit investment platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node --esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "setup-db": "ts-node --esm src/setup-database.ts",
    "migrate": "node scripts/run-migrations.cjs",
    "seed": "node dist/scripts/seed-complete.js",
    "seed:simple": "node dist/scripts/seed-ngo-projects.js",
    "seed:old": "ts-node --esm src/scripts/seed-data.ts",
    "seed:demo": "ts-node --esm src/seeds/demo.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "test": "jest"
  },
  "keywords": [
    "decarbonize",
    "carbon",
    "blockchain",
    "investment",
    "enterprise"
  ],
  "author": "Decarbonize Team",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@sentry/node": "^10.22.0",
    "@sentry/profiling-node": "^10.22.0",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.7",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
