# ============================================
# Production Environment Configuration
# Copy this file to .env.production and fill in the values
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
SERVER_PORT=3002
SERVER_HOST=0.0.0.0
FRONTEND_URL=https://yourdomain.com

# ============================================
# DATABASE CONFIGURATION (Production MySQL)
# ============================================
DB_HOST=your-production-db-host.com
DB_PORT=3306
DB_NAME=decarbonize_production
DB_USER=decarbonize_prod
DB_PASSWORD=your-strong-production-password-here
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secure-refresh-token-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# ENCRYPTION & SECURITY
# ============================================
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-32-byte-encryption-key-for-sensitive-data
SESSION_SECRET=your-session-secret-key-for-cookies

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# EMAIL CONFIGURATION (SendGrid/AWS SES)
# ============================================
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Decarbonize

# Alternative: SMTP
# EMAIL_SERVICE=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-email-password

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================
BLOCKCHAIN_NETWORK=mainnet
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your-infura-project-id
CONTRACT_ADDRESS_DCB=your-dcb-token-contract-address
CONTRACT_ADDRESS_CO2=your-co2-token-contract-address
WALLET_PRIVATE_KEY=your-secure-wallet-private-key

# ============================================
# PAYMENT GATEWAY
# ============================================
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================
# AWS S3 (File Storage)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=decarbonize-prod-files
AWS_S3_PUBLIC_URL=https://cdn.yourdomain.com

# ============================================
# REDIS (Caching & Sessions)
# ============================================
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ============================================
# MONITORING & LOGGING
# ============================================
# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# LogRocket or similar
LOGROCKET_APP_ID=your-logrocket-app-id

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_KYC=true
ENABLE_BLOCKCHAIN=true
ENABLE_PAYMENT_GATEWAY=true

# ============================================
# API KEYS (Third-party services)
# ============================================
CARBON_CALCULATION_API_KEY=your-carbon-api-key
GEOLOCATION_API_KEY=your-geolocation-api-key
ANALYTICS_API_KEY=your-analytics-api-key

# ============================================
# BACKUP & MAINTENANCE
# ============================================
BACKUP_ENABLED=true
BACKUP_S3_BUCKET=decarbonize-prod-backups
BACKUP_SCHEDULE=0 2 * * *
MAINTENANCE_MODE=false
